{
  "manifest_version": 3,
  "name": "AI Workspace Agent",
  "version": "1.0",
  "description": "Smart Assistant for Internships, Interviews & Skills powered by Local LLM.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:5000/*",
    "http://localhost:5000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}